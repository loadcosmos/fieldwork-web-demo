# Optional locally. Vercel deployments use automatic project OIDC.
AI_GATEWAY_API_KEY=
AI_MODEL=anthropic/claude-haiku-5.5

# Link a private Vercel Blob store for shared production quotas and counters.
# Vercel provisions the connection. Local runs can use in-memory counters.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
